# Copy to .env. Leave PayPal keys empty to run in MOCK mode.
# Get Sandbox keys: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: ID of the webhook you register in the PayPal dashboard (for signature checks)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Sandbox charges in USD; the app shows INR
INR_PER_USD=88
PRICING_MARGIN=0.25
PLATFORM_FEE_INR=99
CUTOFF_HOURS=24
AREA_DAY_LIMIT_INR=500000

# Demo mode replays this real rainy day (Besant Nagar 4-10 PM: ERA5 24.9 mm, GFS 11.0 mm)
DEMO_REPLAY_DATE=2023-11-15
DEMO_DRY_DATE=2023-11-26
DEMO_REPLAY_SECONDS=60
